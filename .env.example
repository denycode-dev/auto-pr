# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auto_pr_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# PostgreSQL Prisma Connection URL
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/auto_pr_db?schema=public"

# OpenAI / Qodeer AI Gateway (BR-03)
OPENAI_BASE_URL="https://api.openai.com/v1"
QODEER_API_KEY="your_api_key_here"
OPENAI_MODEL="gpt-4o"
AI_REQUEST_TIMEOUT_MS=60000

# Bitbucket Server 8.19 Integration (BR-04, BR-08)
BITBUCKET_BASE_URL="http://localhost:7990"
BITBUCKET_ACCESS_TOKEN="your_personal_access_token"
BITBUCKET_WEBHOOK_SECRET="your_webhook_secret"
SENIOR_USER_SLUG="senior-reviewer"